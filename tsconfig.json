{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Exclude legacy receipt helpers that are not imported by the app.
    "lib/receipts/owner-name.ts",
    "lib/receipts/period-selection.ts",
    "lib/receipts/period.ts",
    "lib/receipts/vat-apply-rule.ts",
    "lib/receipts/vehicle-number-change-confirmation-state.ts",
    "lib/receipts/vehicle-owner-resolution.ts",
    "lib/receipts/tqms-sync.ts",
    "lib/receipts/manual-receipt-override.ts",
    "utils/fontasy-himali/report-label.ts"
  ]
}
